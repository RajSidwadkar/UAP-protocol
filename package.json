{
  "name": "uap-protocol",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "prepare": "node -e \"try { if (process.env.NODE_ENV !== 'production') { require('child_process').execSync('husky', {stdio: 'inherit'}) } } catch (e) {}\""
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@noble/curves": "2.2.0",
    "@types/node": "25.9.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "turbo": "2.9.16"
  },
  "overrides": {
    "uuid": "11.1.1",
    "semver": "7.5.4",
    "tough-cookie": "4.1.3",
    "word-wrap": "1.2.4",
    "ip": "2.0.1",
    "glob": "10.3.10",
    "inflight": "1.0.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "eslint": {
      "ajv": "6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "6.12.4"
    },
    "esbuild": "0.28.1",
    "fast-uri": "3.1.2",
    "fastify": "5.8.5",
    "vite": "6.4.2",
    "vitest": "3.2.6",
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/sdk-node": "0.219.0"
  },
  "//auditNotes": {
    "ajv-redos-GHSA-2g4f-4pwh-qvx6": "UAP never uses ajv $data option. UapRpcTransport.validate() only calls ajv.compile() with static schemas from BuiltinSchemaRegistry. Not exploitable."
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.219.0"
  }
}
